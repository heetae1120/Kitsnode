{
  // Review-only template. Supply the real Hyperdrive ID and runtime secrets
  // separately. Do not use synthetic terms or enable signup in production.
  "name": "kitsnode-same-origin-review",
  "main": "./same-origin-worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "MEMBER_EMAIL_ENABLED": "0",
    "MEMBER_HYPERDRIVE_SCHEMA_VERIFIED": "0",
    "MEMBER_EDGE_LIMITS_ENABLED": "0"
  },
  // Review-only namespace IDs: replace them with unique IDs for the account
  // and provide MEMBER_RATE_LIMIT_SECRET as a secret before enabling.
  // Limits are approximate and apply separately in each Cloudflare location.
  "ratelimits": [
    {"name": "MEMBER_SITE_LIMIT", "namespace_id": "9117003", "simple": {"limit": 1000, "period": 60}},
    {"name": "MEMBER_IP_LIMIT", "namespace_id": "9117001", "simple": {"limit": 100, "period": 60}},
    {"name": "MEMBER_ACCOUNT_LIMIT", "namespace_id": "9117002", "simple": {"limit": 100, "period": 60}}
  ],
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
